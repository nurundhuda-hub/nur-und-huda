---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { officialSources } from '../lib/sources';
import { sitePath } from '../lib/site';
---

<SiteLayout title="القرآن الكريم" page="quran">
  <PageHeading
    title="القرآن الكريم"
    eyebrow="من المصدر الرسمي"
    description="المصاحف والتطبيقات الرسمية لمجمع الملك فهد لطباعة المصحف الشريف."
  />
  <div class="shell page-body two-column">
    <section class="reading-panel light-surface" aria-labelledby="mushaf-title">
      <p class="eyebrow">مجمع الملك فهد</p>
      <h2 id="mushaf-title">مصحف المدينة النبوية</h2>
      <p>
        المصدر المعتمد: مجمع الملك فهد لطباعة المصحف الشريف. إلى حين استكمال
        تكامل النسخة الرقمية، نربط بالمصدر الرسمي.
      </p>
      <div class="resource-links">
        <a class="resource-link" href={officialSources.quran}>
          <span>
            <strong>المصاحف والتطبيقات الرسمية</strong>
            <small>الانتقال إلى موقع المجمع</small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="resource-link" href={officialSources.quranRights}>
          <span>
            <strong>حقوق استخدام المصحف الرقمي</strong>
            <small>شروط الإصدار الرقمي المشار إليه</small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <aside class="side-note" aria-labelledby="quran-source-title">
      <p class="eyebrow">أمانة النص</p>
      <h2 id="quran-source-title">إحالة موثوقة</h2>
      <p>
        نربط بالمصادر الأصلية. لا نستضيف نصاً أو ملفات للمصحف قبل التحقق من شروط
        الإصدار الرقمي وإذن استخدامه.
      </p>
      <a class="text-link" href={sitePath('legal.html#sources')}>
        المصادر والتراخيص <span aria-hidden="true">←</span>
      </a>
    </aside>
  </div>
</SiteLayout>
