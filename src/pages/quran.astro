---
import SiteLayout from '../layouts/SiteLayout.astro';
import { quranReader, quranReaderUrl } from '../lib/quran-reader';
import { sitePath } from '../lib/site';
import '../styles/quran.css';
import surahs from '../data/quran-surahs.json';
---

<SiteLayout title="القرآن الكريم" page="quran">
  <section
    class="shell quran-reader"
    data-quran-reader
    aria-labelledby="quran-title"
  >
    <header class="quran-reader-header">
      <div>
        <h1 id="quran-title">القرآن الكريم</h1>
        <p>مصحف المدينة النبوية — رواية حفص</p>
      </div>
      <a
        class="button button-outline"
        data-quran-direct
        href={quranReaderUrl(false)}
        target="_blank"
        rel="noopener noreferrer"
        referrerpolicy="no-referrer"
      >
        فتح القارئ مباشرة <span class="sr-only">في نافذة جديدة</span>
      </a>
    </header>
    <div class="quran-surah-control">
      <label for="quran-surah">اختر السورة</label>
      <select
        id="quran-surah"
        data-quran-surah
        disabled
        aria-describedby="quran-reader-hint"
      >
        {surahs.map((surah) => (
          <option value={surah.id}>
            {surah.id}. {surah.name}
          </option>
        ))}
      </select>
    </div>
    <p class="quran-reader-hint" id="quran-reader-hint">
      <span class="quran-mobile-hint">
        إن ظهر اختيار اللغة، اختر «عربي». اختر السورة من القائمة أعلاه.
      </span>
      <span class="quran-desktop-hint">
        اختر السورة أو الصفحة من قوائم القارئ.
      </span>
      إذا لم يظهر المصحف، استخدم «فتح القارئ مباشرة».
    </p>
    <div class="quran-reader-frame">
      <iframe
        data-quran-frame
        src={quranReaderUrl(false)}
        title="مصحف المدينة النبوية — قارئ آيات بجامعة الملك سعود"
        aria-describedby="quran-reader-hint"
        sandbox="allow-scripts allow-same-origin"
        referrerpolicy="no-referrer"
        loading="eager"
      ></iframe>
    </div>
    <p class="quran-attribution">
      القارئ:{' '}
      <a href={quranReader.publisher} target="_blank" rel="noopener noreferrer">
        مشروع آيات — جامعة الملك سعود
      </a>
      . صور المصحف:{' '}
      <a
        href={quranReader.imageSource}
        target="_blank"
        rel="noopener noreferrer"
      >
        مجمع الملك فهد لطباعة المصحف الشريف
      </a>
      .<a href={sitePath('legal.html#sources')}>المصادر والخصوصية</a>
    </p>
  </section>
</SiteLayout>
<script>
  import { initQuranReader } from '../scripts/quran-reader';
  const root = document.querySelector<HTMLElement>('[data-quran-reader]');
  if (root) initQuranReader(root);
</script>
