---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/site';
import { apiEndpoint, prayerLabels } from '../lib/community';
import '../styles/community.css';
const api = apiEndpoint(
  import.meta.env.PUBLIC_PRAYER_API_URL ?? '',
  import.meta.env.DEV || import.meta.env.PUBLIC_PRAYER_MODE === 'local',
);
const group = import.meta.env.PUBLIC_PRAYER_MODE === 'group';
const audience = group ? 'لأعضاء المجموعة المصرّح لهم' : 'لزوار الصفحة العامة';
const live =
  (group || import.meta.env.PUBLIC_PRAYER_MODE === 'production') &&
  import.meta.env.PUBLIC_PRAYER_LIVE_APPROVED === 'true';
const staging =
  Boolean(api) && import.meta.env.PUBLIC_PRAYER_MODE === 'staging';
---

<SiteLayout title="نصلّي معاً" page="together">
  <header class="page-heading shell community-title">
    <h1>نصلّي معاً</h1>
    <p class="page-description">
      اختر جماعة تناسب وقتك، أو أنشئ جماعة جديدة ليشاركك إخوتك الصلاة.
    </p>
  </header>
  <div
    class="shell page-body community"
    data-community
    data-api={api ?? ''}
    data-live={String(live)}
    data-staging={String(staging)}
  >
    <nav class="community-options" aria-label="خيارات المشاركة">
      <a class="community-action secondary" href="#gatherings-title">
        سأنضم إلى جماعة موجودة
      </a>
      <a class="community-action" href="#create-gathering">
        + إنشاء جماعة جديدة
      </a>
    </nav>
    <p class="status">
      {api
        ? live
          ? 'تنسيق الصلاة في مصلى نور وهدى'
          : 'نسخة اختبار — لا تستخدم بيانات أو مواعيد فعلية'
        : 'الخدمة العامة غير مفعّلة بعد'}
    </p>
    {group && (
      <section class="push-panel" data-push aria-labelledby="push-title">
        <h2 id="push-title">إشعارات الجماعة</h2>
        <p class="small">
          اختيارية على هذا الجهاز. إشعار عام عند إنشاء جماعة جديدة، دون أسماء
          على شاشة القفل.
        </p>
        <p data-push-install hidden>
          على iPhone أو iPad (iOS 16.4 فأحدث): افتح الموقع في Safari، اضغط
          مشاركة ثم «إضافة إلى الشاشة الرئيسية». افتحه من الأيقونة الجديدة ثم
          فعّل الإشعارات.
        </p>
        <p data-push-status role="status" aria-live="polite">
          جارٍ التحقق من دعم الإشعارات…
        </p>
        <div class="gathering-actions">
          <button type="button" data-push-enable disabled>
            تفعيل إشعارات الجماعة
          </button>
          <button type="button" data-push-disable hidden>
            إيقاف الإشعارات وحذف الاشتراك
          </button>
        </div>
      </section>
    )}
    {staging && (
      <section
        class="reading-panel light-surface"
        aria-labelledby="staging-access-title"
      >
        <h2 id="staging-access-title">دخول الاختبار الخاص</h2>
        <p>
          هذه تجربة محدودة لمشاركَيْن فقط. الرمز شخصي ومؤقت، ويُحفظ في هذه
          الجلسة حتى تسجيل الخروج. استخدم مواعيد تجريبية فقط.
        </p>
        <form data-staging-login method="post">
          <fieldset data-staging-fields disabled>
            <label for="staging-access-code">رمز الاختبار الخاص بك</label>
            <input
              id="staging-access-code"
              name="accessCode"
              type="password"
              required
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              dir="ltr"
              maxlength="43"
              minlength="43"
            />
            <button type="submit">دخول الاختبار</button>
          </fieldset>
        </form>
        <button type="button" data-staging-logout hidden>
          خروج من الاختبار
        </button>
      </section>
    )}
    <p>
      المواعيد بتوقيت برلين، وهي مواعيد لقاء مقترحة وليست بديلاً عن مواقيت
      الصلاة المعتمدة.
    </p>
    <p data-community-status role="status" aria-live="polite">
      {api
        ? 'جارٍ تحميل الجماعات…'
        : 'لم يُربط الخادم بعد. لا توجد مشاركات تجريبية معروضة على أنها حقيقية.'}
    </p>
    <noscript>
      <p>يلزم تشغيل JavaScript لعرض الجماعات وإدارة مشاركتك.</p>
    </noscript>
    {!staging && (
      <p class="community-name">
        <span data-saved-name>يكفي اسمك الأول، بلا حساب.</span>{' '}
        <button type="button" class="secondary" data-change-name hidden>
          تغيير اسمي
        </button>
      </p>
    )}
    <section aria-labelledby="gatherings-title">
      <div class="community-heading">
        <h2 id="gatherings-title">الجماعات القادمة</h2>
        <button type="button" data-refresh disabled>
          تحديث
        </button>
      </div>
      <p data-empty hidden>
        لا توجد جماعات قادمة الآن. يمكنك إنشاء جماعة.
      </p>
      <div data-gatherings class="gathering-list" aria-busy="false"></div>
    </section>
    <section
      id="create-gathering"
      class="reading-panel light-surface"
      aria-labelledby="create-title"
    >
      <h2 id="create-title">إنشاء جماعة جديدة</h2>
      <p class="small">
        يمكن إنشاء أكثر من جماعة للصلاة نفسها. أنت أول المشاركين في جماعتك.
      </p>
      <form data-create method="post">
        <fieldset disabled>
          <legend class="sr-only">بيانات الجماعة الجديدة</legend>
          {!staging && (
            <div>
              <label for="community-name">الاسم الأول</label>
              <input
                id="community-name"
                name="firstName"
                type="text"
                autocomplete="given-name"
                maxlength="80"
                required
                dir="auto"
                aria-describedby="name-use"
              />
              <p class="small" id="name-use">
                يظهر اسمك الأول {audience}. لا تكتب اسم العائلة.
              </p>
            </div>
          )}
          <label for="community-prayer">الصلاة</label>
          <select id="community-prayer" name="prayer" required>
            {Object.entries(prayerLabels).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <div class="community-datetime">
            <div>
              <label for="community-date">التاريخ</label>
              <input
                id="community-date"
                name="date"
                type="date"
                required
                aria-describedby="community-window"
              />
            </div>
            <div>
              <label for="community-time">الوقت</label>
              <input
                id="community-time"
                name="time"
                type="time"
                step="60"
                required
                aria-describedby="community-window"
              />
            </div>
          </div>
          <p class="small" id="community-window">
            بتوقيت برلين، خلال الساعات الأربع والعشرين القادمة.
            {group
              ? 'تبقى الجماعة ظاهرة حتى ٣٠ دقيقة بعد الموعد.'
              : 'يختفي الموعد عند بدايته.'}
          </p>
          {!staging && (
            <div>
              <label for="community-note">ملاحظة اختيارية</label>
              <textarea
                id="community-note"
                name="note"
                rows="2"
                maxlength="120"
                dir="auto"
                aria-describedby="note-use"
              ></textarea>
              <p class="small" id="note-use">
                ١٢٠ حرفاً كحد أقصى. لا تكتب معلومات المرضى أو الزملاء أو بيانات
                حساسة.
              </p>
            </div>
          )}
          <label data-create-consent class="community-consent">
            <input type="checkbox" name="consent" required />
            {staging
              ? 'أوافق على معالجة المشاركة التجريبية وحفظ مفتاح إدارتها على جهازي.'
              : `أوافق على عرض اسمي الأول ومشاركتي ${audience} لهذا التنسيق المؤقت، وحفظ اسمي ومفتاح مشاركتي على جهازي.`}
          </label>
          <button type="submit">إنشاء الجماعة</button>
        </fieldset>
      </form>
    </section>
    <dialog
      data-consent
      aria-labelledby="name-dialog-title"
      aria-describedby="name-dialog-description"
    >
      <form method="dialog" data-name-form>
        <h2 id="name-dialog-title">
          {staging ? 'تأكيد المشاركة التجريبية' : 'ما اسمك الأول؟'}
        </h2>
        {!staging && (
          <div>
            <label for="join-name">الاسم الأول</label>
            <input
              id="join-name"
              name="firstName"
              autocomplete="given-name"
              maxlength="80"
              required
              dir="auto"
            />
          </div>
        )}
        <p id="name-dialog-description">
          {staging
            ? 'بالمتابعة أوافق على معالجة المشاركة التجريبية وحفظ مفتاح إدارتها محلياً.'
            : `بالمتابعة أوافق على عرض اسمي الأول ومشاركتي ${audience} للتنسيق المؤقت. يُحفظ اسمي على هذا الجهاز للمرة القادمة. قد تدل المشاركة على اهتمام ديني.`}
        </p>
        <p class="small" data-name-edit-note hidden>
          يُستخدم الاسم الجديد في مشاركاتك التالية.
        </p>
        <p data-name-error role="alert"></p>
        <div class="gathering-actions">
          <button type="submit" data-consent-accept>
            سأنضم
          </button>
          <button type="button" class="secondary" data-name-cancel>
            رجوع
          </button>
        </div>
      </form>
    </dialog>
    <details class="side-note">
      <summary>خصوصية المشاركة</summary>
      <p>
        {group
          ? 'الصفحة مخصصة للمجموعة؛ كل من يملك الرمز يستطيع الدخول.'
          : 'الصفحة عامة.'}{' '}
        نطلب الاسم الأول فقط، بلا حساب أو بريد أو هاتف. لا نحتفظ بسجل حضور.
        يمكنك إلغاء انضمامك لإزالة اسمك من الجماعة.
      </p>
      <p>
        {group
          ? 'تختفي الجماعة بعد ٣٠ دقيقة من موعدها،'
          : 'تختفي الجماعة عند موعدها،'}
        وتُحذف أسماؤها وملاحظتها ومفاتيح ملكيتها خلال ساعة بعد ذلك عند عمل
        التنظيف الدوري. تبقى مفاتيح منفصلة للحد من إساءة الاستخدام لمدة لا
        تتجاوز ٢٧ ساعة.
      </p>
      <p>
        يُحفظ اسمك في هذا المتصفح حتى تغييره أو حذف بيانات الموقع؛ ويُحفظ مفتاح
        عشوائي خاص لإدارة مشاركتك لمدة ٢٦ ساعة من آخر إجراء. حذف بيانات الموقع
        أو استخدام جهاز آخر يفقدك التحكم بالمشاركات القديمة ولا يلغيها.
      </p>
      <a class="text-link" href={sitePath('legal.html#prayer-privacy')}>
        تفاصيل الخصوصية وحالة الخدمة
      </a>
    </details>
  </div>
  <script>
    import { initCommunity } from '../scripts/community';
    import { initPush } from '../scripts/push-notifications';
    initCommunity();
    initPush();
  </script>
</SiteLayout>
