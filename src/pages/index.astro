---
import SiteLayout from '../layouts/SiteLayout.astro';
import PrayerCard from '../components/PrayerCard.astro';
import ImamPreview from '../components/ImamPreview.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import { sitePath, tagline } from '../lib/site';
import { sermonRelease } from '../lib/sermons/release';
import { sermonPath } from '../lib/sermons/publication';
import '../styles/home.css';
const featuredSermon = sermonRelease.published[0]?.sermon;
const modules = [
  {
    id: 'together',
    icon: 'community',
    title: 'نصلّي معاً',
    text: 'أنشئ جماعة أو انضمّ إليها، بالاسم الأول فقط.',
    path: 'together.html',
  },
  {
    id: 'sermons',
    icon: 'sermon',
    title: 'منبر الجمعة',
    text: 'الخطب المعتمدة وشروحها الموسّعة.',
    path: 'sermons.html',
  },
  {
    id: 'quran',
    icon: 'quran',
    title: 'القرآن الكريم',
    text: 'المصحف من مصادره الرسمية.',
    path: 'quran.html',
  },
  {
    id: 'library',
    icon: 'library',
    title: 'المكتبة الإسلامية',
    text: 'مصادر مختارة للعلم النافع.',
    path: 'library.html',
  },
] as const;
---

<SiteLayout title="الرئيسية" page="home">
  <div class="home-intro">
    <section class="hero home-hero" id="home" aria-labelledby="home-title">
      <div class="hero-identity">
        <h1 id="home-title" class="sr-only">
          نور وهدى
        </h1>
        <img
          class="hero-logo"
          src={sitePath('assets/logo.webp')}
          alt={`نور وهدى — Nour und Huda — ${tagline}`}
          width="1672"
          height="941"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>
    <div class="shell prayer-stage">
      <PrayerCard />
    </div>
  </div>
  <section
    class="shell home-services"
    id="explore"
    aria-labelledby="explore-title"
  >
    <div class="home-section-title">
      <span aria-hidden="true"></span>
      <h2 id="explore-title">أبواب الخير</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="service-grid">
      {modules.map((module) => (
        <a id={module.id} class="service-card" href={sitePath(module.path)}>
          <span class="service-icon">
            <FeatureIcon name={module.icon} />
          </span>
          <h3 id={`home-${module.id}-title`}>{module.title}</h3>
          <p>{module.text}</p>
          <span class="service-arrow" aria-hidden="true">
            ←
          </span>
        </a>
      ))}
    </div>
    {featuredSermon ? (
      <section class="home-sermon" aria-label="الخطبة المتاحة">
        <div>
          <p class="eyebrow">منبر الجمعة</p>
          <a
            href={sitePath(
              sermonPath(featuredSermon.id, featuredSermon.revision),
            )}
          >
            {featuredSermon.title}
          </a>
        </div>
        <a
          class="button button-outline"
          href={
            sitePath(sermonPath(featuredSermon.id, featuredSermon.revision)) +
            '#imam'
          }
        >
          وضع الإمام
        </a>
      </section>
    ) : (
      <div class="home-sermon">
        <p>تُتاح الخطب بعد المراجعة والاعتماد.</p>
        <ImamPreview id="home-imam" />
      </div>
    )}
    <a class="about-card" href={sitePath('legal.html#impressum')}>
      <span class="service-icon">
        <FeatureIcon name="prayer" />
      </span>
      <div>
        <h2>عن المصلى</h2>
        <p>مشروع تطوعي مستقل — المعلومات والتواصل</p>
      </div>
      <span class="about-arrow" aria-hidden="true">
        ←
      </span>
    </a>
  </section>
</SiteLayout>
