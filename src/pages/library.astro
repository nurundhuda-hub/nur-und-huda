---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import SourceDirectory from '../components/SourceDirectory.astro';
import { sitePath } from '../lib/site';
---

<SiteLayout title="المكتبة الإسلامية" page="library">
  <PageHeading
    title="المكتبة الإسلامية"
    eyebrow="من المصدر إلى القارئ"
    description="مصادر عربية وألمانية من رسالة الحرمين، مع الإحالة إلى النسخ الأصلية."
  />
  <div class="shell page-body">
    <section
      class="reading-panel light-surface"
      aria-labelledby="directory-title"
    >
      <div class="section-heading">
        <h2 id="directory-title">دليل المصادر</h2>
        <span class="status">روابط إلى المصادر الأصلية</span>
      </div>
      <p>
        نبدأ بدليل للمصادر، دون إعادة استضافة الكتب. يمكنك البحث باسم المصدر أو
        اللغة.
      </p>
      <SourceDirectory />
    </section>
    <p class="directory-footnote">
      نراجع روابط الكتب وبياناتها قبل إضافتها إلى الفهرس.{' '}
      <a href={sitePath('legal.html#sources')}>المصادر والتراخيص</a>
    </p>
  </div>
</SiteLayout>
