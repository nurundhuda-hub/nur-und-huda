---
import { sitePath } from '../lib/site';
interface Props {
  title: string;
  eyebrow: string;
  description: string;
}
const { title, eyebrow, description } = Astro.props;
---

<header class="page-heading shell">
  <a class="back-link" href={sitePath('index.html')}>
    العودة إلى الرئيسية <span aria-hidden="true">←</span>
  </a>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="page-description">{description}</p>
</header>
