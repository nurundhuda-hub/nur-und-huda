# Copy into .env.<DEDICATED_STAGING_PROJECT_ID>, never into the public build.
PRAYER_ALLOWED_ORIGINS=https://YOUR-VERIFIED-STAGING-ORIGIN
PRAYER_SERVICE_ACCOUNT=prayer-runtime@YOUR-DEDICATED-PROJECT.iam.gserviceaccount.com
# Mandatory server gate: private JSON containing issuedAt/expiresAt (<=72h)
# and one or two unique SHA-256 hashes of separately issued 256-bit access codes.
# Empty configuration denies all API data access. Never put plaintext codes here.
PRAYER_STAGING_ACCESS=''
