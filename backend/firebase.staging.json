{
  "hosting": {
    "site": "nour-und-huda-staging",
    "public": ".staging-site",
    "ignore": ["**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/",
        "destination": "/nur-und-huda/together.html",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  }
}
